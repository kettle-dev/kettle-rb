module Kettle
  module Rb
    # See the writing guide of rbs: https://github.com/ruby/rbs#guides
    module Version
      VERSION: String
    end
    VERSION: String

    module RubySeriesBuckets
      def self.from_minor_versions: (Array[String | Gem::Version]) -> { buckets: Array[String], bucket_ranges: Hash[String, { floor: Gem::Version, ceiling: Gem::Version }] }
      def self.ranges_for_buckets: (Array[String]) -> Hash[String, { floor: Gem::Version, ceiling: Gem::Version }]
      def self.relevant_buckets: (Array[String], minimum: String | Gem::Version) -> Array[String]
    end
  end
end
